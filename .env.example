# ============================================================
# Umira AI — BACKEND (NestJS API)
#   cp .env.example .env      (atau: npm run setup:mac / setup:ubuntu)
# Generate secret acak:  openssl rand -base64 48
# ============================================================

# --- Wajib ---
JWT_ACCESS_SECRET=ganti-dengan-string-acak-minimal-32-karakter
APP_ENCRYPTION_KEY=ganti-dengan-string-acak-lain-minimal-32-karakter
DATABASE_URL=mysql://umira:umira_password@127.0.0.1:3306/umira_ai

# --- Server ---
API_PORT=4000
# 127.0.0.1 bila di belakang Nginx di server yang sama; 0.0.0.0 bila diakses langsung
API_HOST=0.0.0.0

# --- Hubungan dengan FRONTEND ---
# Origin frontend yang boleh memanggil API (pisahkan dengan koma), mis. https://ai.umira.id
CORS_ORIGINS=http://localhost:3000
# URL frontend — dipakai untuk link reset password
APP_URL=http://localhost:3000
# Cookie refresh token:
#  - frontend & backend satu site (ai.umira.id + api.umira.id, atau localhost) → lax
#  - beda site sama sekali → none (wajib HTTPS)
COOKIE_SAMESITE=lax
# true bila backend sudah HTTPS
COOKIE_SECURE=false
# Opsional, mis. .umira.id agar cookie berlaku di semua subdomain
COOKIE_DOMAIN=

# --- Redis OPSIONAL (kosong = in-memory, cukup untuk 1 proses API) ---
REDIS_URL=

# --- Hermes Agent milik sendiri (API server OpenAI-compatible) ---
# Di ~/.hermes/.env Hermes:  API_SERVER_ENABLED=true   API_SERVER_KEY=<sama dengan HERMES_API_KEY>
HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=ganti-dengan-API_SERVER_KEY-hermes
HERMES_MODEL=hermes-agent

# --- Provider lain (opsional; bisa juga diisi lewat Dashboard → Konfigurasi API) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1

# --- Admin awal (opsional; tanpa ini pengguna pertama yang daftar = ADMIN) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# --- Lain-lain ---
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=14
RATE_LIMIT_PER_MINUTE=120
# 5 menit; agent dengan banyak tool bisa butuh lebih lama
CHAT_TIMEOUT_MS=300000
USD_TO_IDR=16000
SWAGGER_ENABLED=true
